{
  "name": "Ayu Dark (10-group)",
  "type": "dark",
  "semanticHighlighting": true,

  "colors": {
    // --- Base ---
    // Surface tiers mirror kdeglobals: View #0B0E14, Window #14171D, Button #1A1D23.
    // The editor gets the deepest tier so code sits below the chrome, same as
    // kitty's background against the wayle bar.
    "foreground": "#B8B5AC",
    "focusBorder": "#FF8F40",
    "disabledForeground": "#3D4046",
    "descriptionForeground": "#5C6773",
    "errorForeground": "#F07178",
    "selection.background": "#FF8F4066",
    "widget.border": "#1A1D23",
    "widget.shadow": "#00000066",
    "icon.foreground": "#B8B5AC",
    "sash.hoverBorder": "#FF8F40",
    "textLink.foreground": "#59C2FF",
    "textLink.activeForeground": "#73D0FF",
    "textPreformat.foreground": "#80DDB8",
    "textBlockQuote.background": "#14171D",
    "textBlockQuote.border": "#FF8F40",
    "textCodeBlock.background": "#14171D",
    "textSeparator.foreground": "#1A1D23",

    // --- Editor ---
    "editor.background": "#0B0E14",
    "editor.foreground": "#B8B5AC",
    "editorLineNumber.foreground": "#3D4046",
    "editorLineNumber.activeForeground": "#FF8F40",
    "editorCursor.foreground": "#FF8F40",
    "editorCursor.background": "#0B0E14",
    // kitty renders selection as solid orange; at editor scale that is far too
    // loud, so the same accent is used at 20% over the background instead.
    "editor.selectionBackground": "#FF8F4033",
    "editor.selectionHighlightBackground": "#FF8F401A",
    "editor.inactiveSelectionBackground": "#FF8F4014",
    "editor.wordHighlightBackground": "#59C2FF26",
    "editor.wordHighlightStrongBackground": "#80DDB826",
    "editor.findMatchBackground": "#FF8F4059",
    "editor.findMatchHighlightBackground": "#E6C54C33",
