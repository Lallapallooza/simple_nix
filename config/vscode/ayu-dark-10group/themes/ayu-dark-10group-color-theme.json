  // Semantic tokens are the LSP layer -- the direct analogue of the
  // @lsp.type.* table in config/nvim/lua/chadrc.lua. They win over the
  // TextMate rules below, which is what gives rust-analyzer / clangd /
  // basedpyright their type-level precision.
  "semanticTokenColors": {
    // 1. Keywords
    "keyword": "#FF7733",
    "modifier": "#FF7733",

    // 2. Functions
    "function": "#E6C54C",
    "method": "#E6C54C",
    "function.defaultLibrary": "#E6C54C",

    // 3. Strings
    "string": "#AAD94C",
    "formatSpecifier": "#80DDB8",
    "escapeSequence": "#80DDB8",

    // 4. Types + modules
    "type": "#59C2FF",
    "class": "#59C2FF",
    "struct": "#59C2FF",
    "interface": "#59C2FF",
    "enum": "#59C2FF",
    "union": "#59C2FF",
    "typeParameter": "#59C2FF",
    "typeAlias": "#59C2FF",
    "namespace": "#59C2FF",
    "builtinType": "#59C2FF",

    // 5. Constants -- readonly bindings land here too, matching @constant
    "number": "#C4B070",
    "enumMember": "#C4B070",
    "variable.readonly": "#C4B070",
    "variable.readonly.defaultLibrary": "#C4B070",

    // 6. Self / builtins
    "selfKeyword": "#39BAE6",
    "selfTypeKeyword": "#39BAE6",
    "variable.defaultLibrary": "#39BAE6",

    // 7. Properties
    "property": "#80DDB8",
    "field": "#80DDB8",
    "member": "#80DDB8",

    // 8. Parameters
    "parameter": "#D2A6FF",
    "lifetime": "#D2A6FF",
    "typeParameter.declaration": "#D2A6FF",

    // 9. Decorators / macros
    "decorator": "#E6C08A",
    "macro": "#E6C08A",
    "attribute": "#E6C08A",
    "derive": "#E6C08A",
    "attributeBracket": "#E6C08A",

    // 10. Operators
    "operator": "#CC7832",
    "arithmetic": "#CC7832",
    "bitwise": "#CC7832",
    "comparison": "#CC7832",
    "logical": "#CC7832",

    // Ground level
    "variable": "#B8B5AC",
    "comment": "#5C6773",
    "punctuation": "#887799",
    "brace": "#887799",
    "bracket": "#887799",
    "parenthesis": "#887799",
    "semicolon": "#887799",
    "comma": "#887799",
    "label": "#59C2FF",

    // Modifiers -- mirrors @lsp.mod.deprecated / @lsp.mod.deactivated.
    // `unsafe` is rust-analyzer's; red is the one place this config uses
    // color as a warning inside code.
    "*.deprecated": {
      "strikethrough": true
    },
    "*.unsafe": "#F07178",
    "comment.documentation": "#5C6773"
  },

  // TextMate rules are the treesitter-equivalent layer: they cover files with
  // no language server attached, and every scope a server leaves untagged.
  // Later rules win, so these run general -> specific.
  "tokenColors": [
    {
      "name": "Ground level -- variables and plain text",
      "scope": [
        "variable",
        "variable.other",
        "variable.other.readwrite",
        "meta.definition.variable.name",
        "support.variable",
        "source"
      ],
      "settings": { "foreground": "#B8B5AC" }
    },
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": { "foreground": "#5C6773" }
    },
    {
      "name": "Punctuation -- quiet scaffolding",
      "scope": [
        "punctuation",
        "punctuation.definition",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.accessor",
        "punctuation.section",
        "meta.brace",
        "meta.delimiter"
      ],
      "settings": { "foreground": "#887799" }
    },
    {
      "name": "10. Operators -- dark orange, below keyword brightness",
      "scope": [
        "keyword.operator",
        "keyword.operator.arithmetic",
        "keyword.operator.assignment",
        "keyword.operator.comparison",
        "keyword.operator.logical",
        "keyword.operator.bitwise",
        "keyword.operator.relational",
        "keyword.operator.ternary",
        "punctuation.separator.operator"
      ],
      "settings": { "foreground": "#CC7832" }
    },
    {
      "name": "1. Keywords -- the anchor color",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.other",
        "keyword.control.flow",
        "keyword.control.conditional",
        "keyword.control.loop",
        "keyword.control.exception",
        "keyword.control.return",
        "storage",
        "storage.type",
        "storage.modifier",
        "storage.class",
        "variable.language.super"
      ],
      "settings": { "foreground": "#FF7733" }
    },
    {
      "name": "1b. Word operators read as keywords, not symbols",
      "scope": [
        "keyword.operator.word",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.delete",
        "keyword.operator.in",
        "keyword.operator.of",
        "keyword.operator.instanceof",
        "keyword.operator.sizeof"
      ],
      "settings": { "foreground": "#FF7733" }
    },
    {
      "name": "4. Types, classes, namespaces, tags",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.struct",
        "entity.name.enum",
        "entity.name.union",
        "entity.name.trait",
        "entity.name.interface",
        "entity.name.namespace",
        "entity.name.scope-resolution",
        "entity.other.inherited-class",
        "support.type",
        "support.class",
        "storage.type.primitive",
        "storage.type.built-in",
        "entity.name.tag",
        "meta.type.name"
      ],
      "settings": { "foreground": "#59C2FF" }
    },
    {
      "name": "4b. Imports and module paths are type-adjacent",
      "scope": [
        "keyword.control.import",
        "keyword.control.from",
        "keyword.control.export",
        "keyword.other.import",
        "keyword.other.using",
        "keyword.package",
        "entity.name.module",
        "support.module"
      ],
      "settings": { "foreground": "#59C2FF" }
    },
    {
      "name": "2. Functions and methods",
      "scope": [
        "entity.name.function",
        "entity.name.method",
        "support.function",
        "meta.function-call",
        "meta.function-call.generic",
        "variable.function",
        "entity.name.function.member"
      ],
      "settings": { "foreground": "#E6C54C" }
    },
    {
      "name": "3. Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.quoted.single",
        "string.quoted.double",
        "string.quoted.triple",
        "string.template",
        "string.unquoted",
        "string.interpolated",
        "punctuation.definition.string"
      ],
      "settings": { "foreground": "#AAD94C" }
    },
    {
      "name": "3b. Regex, escapes and format specifiers -- mint, same as properties",
      "scope": [
        "string.regexp",
        "constant.character.escape",
        "constant.other.placeholder",
        "punctuation.definition.template-expression",
        "meta.template.expression",
        "constant.character.format.placeholder"
      ],
      "settings": { "foreground": "#80DDB8" }
    },
    {
      "name": "5. Constants and numbers -- muted gold, dimmer than fg so they recede",
      "scope": [
        "constant",
        "constant.numeric",
        "constant.numeric.integer",
        "constant.numeric.float",
        "constant.numeric.hex",
        "constant.language",
        "constant.language.boolean",
        "constant.language.null",
        "constant.other",
        "constant.character",
        "variable.other.constant",
        "variable.other.enummember",
        "support.constant"
      ],
      "settings": { "foreground": "#C4B070" }
    },
    {
      "name": "6. Self and builtins",
      "scope": [
        "variable.language",
        "variable.language.this",
        "variable.language.self",
        "keyword.other.this",
        "support.type.builtin",
        "support.variable.language"
      ],
      "settings": { "foreground": "#39BAE6" }
    },
    {
      "name": "7. Properties, fields, object keys, tag attributes",
      "scope": [
        "variable.other.property",
        "variable.other.member",
        "variable.other.object.property",
        "support.variable.property",
        "meta.object-literal.key",
        "entity.name.variable.field",
        "entity.other.attribute-name",
        "meta.attribute.class"
      ],
      "settings": { "foreground": "#80DDB8" }
    },
    {
      "name": "8. Parameters and lifetimes",
      "scope": [
        "variable.parameter",
        "meta.function.parameters variable",
        "meta.parameter",
        "storage.modifier.lifetime",
        "entity.name.lifetime",
        "punctuation.definition.lifetime"
      ],
      "settings": { "foreground": "#D2A6FF" }
    },
    {
      "name": "9. Decorators, macros, attributes, preprocessor",
      "scope": [
        "entity.name.function.decorator",
        "entity.name.function.macro",
        "entity.name.function.preprocessor",
        "meta.decorator",
        "punctuation.decorator",
        "meta.attribute",
        "meta.annotation",
        "storage.type.annotation",
        "keyword.control.directive",
        "keyword.preprocessor",
        "punctuation.definition.directive",
        "entity.name.function.directive"
      ],
      "settings": { "foreground": "#E6C08A" }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal",
        "invalid.broken"
      ],
      "settings": { "foreground": "#F07178" }
    },
    {
      "name": "Deprecated",
      "scope": "invalid.deprecated",
      "settings": { "foreground": "#3D4046" }
    },
    {
      "name": "Diff",
      "scope": [
        "markup.inserted",
        "meta.diff.header.to-file",
        "punctuation.definition.inserted"
      ],
      "settings": { "foreground": "#AAD94C" }
    },
    {
      "scope": [
        "markup.deleted",
        "meta.diff.header.from-file",
        "punctuation.definition.deleted"
      ],
      "settings": { "foreground": "#F07178" }
    },
    {
      "scope": [
        "markup.changed",
        "punctuation.definition.changed"
      ],
      "settings": { "foreground": "#E6C54C" }
    },
    {
      "name": "Markdown -- headings, emphasis, code, links",
      "scope": [
        "markup.heading",
        "entity.name.section",
        "punctuation.definition.heading"
      ],
      "settings": { "foreground": "#59C2FF", "fontStyle": "bold" }
    },
    {
      "scope": "markup.bold",
      "settings": { "foreground": "#FF8F40", "fontStyle": "bold" }
    },
    {
      // No italic anywhere -- the monospace grid stays intact, same rule the
      // neovim theme follows. Emphasis carries through color instead.
      "scope": "markup.italic",
      "settings": { "foreground": "#FF8F40" }
    },
    {
      "scope": [
        "markup.inline.raw",
        "markup.raw",
        "markup.fenced_code"
      ],
      "settings": { "foreground": "#80DDB8" }
    },
    {
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": { "foreground": "#59C2FF" }
    },
    {
      "scope": "markup.quote",
      "settings": { "foreground": "#5C6773" }
    },
    {
      "scope": "markup.list punctuation.definition.list",
      "settings": { "foreground": "#FF8F40" }
    },
    {
      "name": "Config formats -- JSON/YAML/TOML keys read as properties",
      "scope": [
        "support.type.property-name.json",
        "support.type.property-name.toml",
        "entity.name.tag.yaml",
        "support.type.property-name.table.toml"
      ],
      "settings": { "foreground": "#80DDB8" }
    },
    {
      "name": "Shell -- variables keep parameter purple",
      "scope": [
        "variable.other.normal.shell",
        "variable.other.bracket.shell",
        "punctuation.definition.variable.shell"
      ],
      "settings": { "foreground": "#D2A6FF" }
    }
  ]
}
