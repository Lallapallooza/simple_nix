    "editorBracketMatch.background": "#FF8F4026",
    "editorBracketMatch.border": "#FF8F40",
    "editorLink.activeForeground": "#59C2FF",

    // Inlay hints -- rust-analyzer and clangd lean on these heavily.
    // Type hints reuse type blue, parameter hints reuse parameter purple, so an
    // inline hint reads as the same role it would if written out.
    "editorInlayHint.foreground": "#5C6773",
    "editorInlayHint.background": "#14171D",
    "editorInlayHint.typeForeground": "#59C2FF",
    "editorInlayHint.typeBackground": "#14171D",
    "editorInlayHint.parameterForeground": "#D2A6FF",
    "editorInlayHint.parameterBackground": "#14171D",

    // Bracket pair colorization -- ordered to avoid adjacent red/green pairs,
    // same CVD constraint as the syntax groups.
    "editorBracketHighlight.foreground1": "#FF8F40",
    "editorBracketHighlight.foreground2": "#59C2FF",
    "editorBracketHighlight.foreground3": "#D2A6FF",
    "editorBracketHighlight.foreground4": "#80DDB8",
    "editorBracketHighlight.foreground5": "#E6C54C",
    "editorBracketHighlight.foreground6": "#39BAE6",
    "editorBracketHighlight.unexpectedBracket.foreground": "#F07178",

