    "editor.lineHighlightBackground": "#14171D",
    "editor.lineHighlightBorder": "#00000000",
    "editor.rangeHighlightBackground": "#14171D",
    "editor.hoverHighlightBackground": "#59C2FF26",
    "editor.foldBackground": "#14171D",
    "editorWhitespace.foreground": "#1A1D23",
    "editorIndentGuide.background1": "#1A1D23",
